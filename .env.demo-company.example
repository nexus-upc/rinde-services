# Copiar a .env.demo-company en la raíz de rinde-backend (ignorado por Git).
# Completar con valores propios antes de ejecutar scripts/seed-demo.ps1.

RINDE_GATEWAY_URL=http://localhost:8000

# Empresa de demostración
DEMO_COMPANY_TRADE_NAME=Transportes Ruta Segura SAC
DEMO_COMPANY_RUC=20601234567
DEMO_COMPANY_PHONE=+51 1 445 8899
DEMO_COMPANY_ADDRESS=Av. Nicolas Arriola 1200, La Victoria, Lima

# Administrador de la empresa
DEMO_ADMIN_NAME=Ana Rojas Paredes
DEMO_ADMIN_EMAIL=admin@rutasegura.example.invalid
DEMO_ADMIN_PASSWORD=REPLACE_WITH_DEMO_ADMIN_PASSWORD

# Responsable de operaciones
DEMO_OPS_NAME=Carlos Mendoza Quispe
DEMO_OPS_EMAIL=operaciones@rutasegura.example.invalid
DEMO_OPS_PASSWORD=REPLACE_WITH_DEMO_OPS_PASSWORD

# Conductores (cuentas DRIVER vinculadas en Fleet)
DEMO_DRIVER1_NAME=Luis Quispe Mamani
DEMO_DRIVER1_EMAIL=conductor1@rutasegura.example.invalid
DEMO_DRIVER1_PASSWORD=REPLACE_WITH_DEMO_DRIVER1_PASSWORD

DEMO_DRIVER2_NAME=Marco Paredes Huaman
DEMO_DRIVER2_EMAIL=conductor2@rutasegura.example.invalid
DEMO_DRIVER2_PASSWORD=REPLACE_WITH_DEMO_DRIVER2_PASSWORD

# Opcional: dueño de plataforma para leer /api/v1/platform/demo-mailbox/messages
PLATFORM_OWNER_EMAIL=
PLATFORM_OWNER_PASSWORD=

# Opcional: token manual de verificación si el buzón de demostración no está activo
DEMO_VERIFICATION_TOKEN=
