# Copia este archivo como .env en la raíz del servicio y completa los valores.
DB_URL=jdbc:postgresql://localhost:5432/rinde_subscription
DB_USERNAME=postgres
DB_PASSWORD=
JWT_SECRET=
IAM_SERVICE_URL=http://localhost:8081
FLEET_SERVICE_URL=http://localhost:8083
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
# Clave del webhook de pago simulado (al menos 32 caracteres). Se deja vacía en la plantilla.
RINDE_BILLING_SIMULATION_WEBHOOK_SECRET=
# Activa el pago simulado y su confirmación manual (solo entorno universitario).
RINDE_BILLING_SIMULATION_ENABLED=false
# Clave de los tokens de PLATFORM_OWNER. Debe ser distinta de JWT_SECRET.
RINDE_PLATFORM_JWT_SECRET=
